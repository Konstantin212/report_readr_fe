# Required in Vercel Production and Preview.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# "open" (default): anyone can sign up. "restricted": only emails in
# AUTHORIZED_EMAILS or the DB-backed allowlist (Settings → Members) can
# sign up or sign in.
AUTH_SIGNUP_MODE="open"

# Optional even in restricted mode (the DB allowlist can be used
# instead/as well). Required only if you want an allowlist baked into
# env vars rather than managed via Settings → Members.
AUTHORIZED_EMAILS="you@example.com,girlfriend@example.com"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional. GitHub sign-in is hidden unless both values are configured.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Local-only bypass for UI development. Never enable this on Vercel.
AUTH_DEMO_MODE="false"
AUTH_DEMO_EMAIL="you@example.com"

CRON_SECRET="generated-by-vercel-when-cron-runs"

# Gates the abandoned-account *deletion* step of /api/cron/auth-cleanup
# (design doc §23/§24). Expired password-reset tokens are always
# cleaned up regardless of this flag. Defaults to "false" (log-only
# dry-run) — set to "true" once you've reviewed a few days of dry-run
# logs and are confident the safeguard predicate is behaving as
# expected in production.
AUTH_CLEANUP_DELETE_ENABLED="false"

# Spot-price provider chain. Both are free; both are needed because
# each one's free tier covers different exchanges.
#
# FMP — US stocks (NYSE/NASDAQ/AMEX), unlimited symbols per batched
# call, 250 req/day. Sign up at https://financialmodelingprep.com .
# Without it the orchestrator skips straight to Twelve Data.
FMP_API_KEY=""

# Twelve Data — works from Vercel data-center IPs (Yahoo blocks them,
# Stooq now bot-challenges), covers US + LSE + Xetra + Amsterdam +
# Stockholm. Free tier: 8 credits/min, 800/day. Used here for the
# international tickers FMP free doesn't price.
# Sign up at https://twelvedata.com .
TWELVE_DATA_API_KEY=""

# Required for sending verification/reset-password emails (design doc
# §14/§17). Sign up at https://resend.com . Without it, sending an auth
# email throws (see src/lib/email/resend.ts) — there is no console
# fallback, so this must be set even in local development if you want
# to exercise sign-up/forgot-password end to end.
RESEND_API_KEY=""

# Must be a verified sender/domain in your Resend account, e.g.
# "Folio <noreply@yourdomain.com>".
RESEND_FROM_EMAIL=""

# Optional. Domain-migration cutover window only (design doc §17.4) —
# keeps a legacy domain in better-auth's trustedOrigins so
# verification/reset-password links emailed before BETTER_AUTH_URL was
# flipped to a new domain still work for their full TTL. Unset once
# that window has passed.
BETTER_AUTH_LEGACY_ORIGIN=""
